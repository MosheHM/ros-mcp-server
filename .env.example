# Example Environment Configuration
# Copy this file to .env.development or .env.production and customize

# Environment Type (development, production)
ENVIRONMENT=development

# MCP Server Settings
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9000

# ROS Bridge Settings
ROSBRIDGE_IP=127.0.0.1
ROSBRIDGE_PORT=9090

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=standard

# Debug Mode
DEBUG=false
