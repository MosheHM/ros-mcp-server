# Development Environment Configuration
# ROS MCP Server - Development Settings

# Environment Type
ENVIRONMENT=development

# MCP Server Settings
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9000

# ROS Bridge Settings
ROSBRIDGE_IP=127.0.0.1
ROSBRIDGE_PORT=9090

# Logging Settings
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed

# Debug Mode
DEBUG=true
