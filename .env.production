# Production Environment Configuration
# ROS MCP Server - Production Settings

# Environment Type
ENVIRONMENT=production

# MCP Server Settings
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=9000

# ROS Bridge Settings
ROSBRIDGE_IP=127.0.0.1
ROSBRIDGE_PORT=9090

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Debug Mode
DEBUG=false

# Security Settings (optional - for future use)
# ENABLE_AUTH=true
# API_KEY_REQUIRED=true
